# --- Base de donnees (PostgreSQL + PostGIS) ---
POSTGRES_USER=ayinon
POSTGRES_PASSWORD=change-moi-en-production
POSTGRES_DB=ayinon
POSTGRES_PORT=5432
DATABASE_URL="postgresql://ayinon:change-moi-en-production@localhost:5432/ayinon?schema=public"

# --- API NestJS ---
API_PORT=3000
WEB_ORIGIN="http://localhost:5173"
NODE_ENV=development

# Secret JWT de l'access token - a regenerer en production (openssl rand -hex 32)
# Le refresh token est un jeton opaque (non-JWT) stocke hache en base, revocable individuellement.
JWT_ACCESS_SECRET="dev-access-secret-a-ne-jamais-utiliser-en-prod"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Cle de signature Ed25519 du registre d'audit (paire hex generee au demarrage si absente en dev)
AUDIT_ED25519_PRIVATE_KEY=""
AUDIT_ED25519_PUBLIC_KEY=""

# --- Chatbot assistant (Google Gemini, tool-calling sur les donnees reelles) ---
# Cle a obtenir sur https://aistudio.google.com/apikey — sans elle, POST /chatbot/messages repond 503.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
# Temperature basse par defaut (reponses factuelles et stables) ; maxOutputTokens plafonne la
# longueur d'une reponse (cout/latence).
GEMINI_TEMPERATURE="0.4"
GEMINI_MAX_OUTPUT_TOKENS="1024"

# --- Frontend Vue (Vite) ---
VITE_API_BASE_URL="http://localhost:3000"
