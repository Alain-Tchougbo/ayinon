server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Relaie vers l'API en conservant le prefixe /api (le backend NestJS l'attend, voir
  # main.ts: app.setGlobalPrefix("api")) — le navigateur ne voit jamais cette adresse interne.
  location /api/ {
    proxy_pass ${API_UPSTREAM_URL}/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ~* \.(?:js|css|woff2?|png|jpg|jpeg|svg|ico|webmanifest)$ {
    expires 30d;
    access_log off;
    try_files $uri =404;
  }

  # SPA (Vue Router en mode history) : toute route inconnue retombe sur index.html.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
